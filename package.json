{
  "name": "extra-games-launcher",
  "version": "0.5.4",
  "description": "Extra Games desktop game store and launcher",
  "main": "electron/main.js",
  "author": "Extra Games",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "stripe": "^19.1.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.extragames.launcher",
    "productName": "Extra Games",
    "executableName": "ExtraGamesLauncher",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "server.js",
      "api/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Extra-Games-Launcher-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Extra Games Launcher",
      "uninstallDisplayName": "Extra Games Launcher",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "coolbacon323-cmd",
        "repo": "Extra-Games"
      }
    ]
  }
}
